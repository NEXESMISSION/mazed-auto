# Required: Supabase project URL + anon key (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Required for server routes (e.g. /api/payment/record). Service role key bypasses
# RLS — set as a secret env var in Vercel, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Optional: canonical site URL used for absolute OG/Twitter URLs and the
# metadataBase. On Vercel this falls back to VERCEL_URL automatically.
NEXT_PUBLIC_SITE_URL=https://mazedauto.tn

# Sentry — leave blank to disable error tracking entirely. The DSN is public
# and safe to expose. SENTRY_ORG/PROJECT/AUTH_TOKEN are only needed at build
# time to upload source maps; set as Vercel secrets, never commit.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=mazed-auto-web
SENTRY_AUTH_TOKEN=

# Payment provider — Konnect.network (Tunisia)
# Used by the subscription checkout flow on /pricing. To activate the real
# gateway, set these vars AND flip `payment.active_provider` to "konnect"
# from /admin/settings. Without these the system falls back to "simulation".
#
# Sandbox: get keys at https://konnect.network → Dashboard → API
# Production: switch KONNECT_API_URL to https://api.konnect.network
KONNECT_API_KEY=
KONNECT_WALLET_ID=
KONNECT_API_URL=https://api.preprod.konnect.network
